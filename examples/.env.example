# Copy this file to .env and fill in the values.
# Keep .env out of version control; this file is safe to commit.
# Refresh it with: npx @saizul/envguard example

# one of development | production | test, default: development
NODE_ENV=development

# Port the HTTP server listens on
# port (1-65535), default: 3000
PORT=3000

# Postgres connection string
# url (postgres, postgresql), required, secret
DATABASE_URL=

# url, optional
REDIS_URL=redis://localhost:6379

# Signs session cookies
# string, required, secret
SESSION_SECRET=

# email, required
ADMIN_EMAIL=admin@example.com

# duration (e.g. 500ms, 30s, 5m, 1h30m), default: 30s
REQUEST_TIMEOUT=30s

# list separated by ",", default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# json, default: {}
FEATURE_FLAGS="{}"

# one of debug | info | warn | error, default: info
LOG_LEVEL=info

# boolean (true/false), default: true
ENABLE_SIGNUPS=true
