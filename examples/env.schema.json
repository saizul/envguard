{
  "NODE_ENV": {
    "type": "enum",
    "values": ["development", "production", "test"],
    "default": "development"
  },
  "PORT": { "type": "port", "default": 3000, "description": "Port the HTTP server listens on" },
  "DATABASE_URL": {
    "type": "url",
    "protocols": ["postgres", "postgresql"],
    "secret": true,
    "description": "Postgres connection string",
    "aliases": ["POSTGRES_URL"]
  },
  "REDIS_URL": { "type": "url", "optional": true, "example": "redis://localhost:6379" },
  "SESSION_SECRET": {
    "type": "string",
    "secret": true,
    "minLength": 32,
    "description": "Signs session cookies"
  },
  "ADMIN_EMAIL": { "type": "email", "example": "admin@example.com" },
  "REQUEST_TIMEOUT": { "type": "duration", "default": "30s" },
  "ALLOWED_ORIGINS": { "type": "list", "default": "http://localhost:3000" },
  "FEATURE_FLAGS": { "type": "json", "default": "{}" },
  "LOG_LEVEL": { "type": "enum", "values": ["debug", "info", "warn", "error"], "default": "info" },
  "ENABLE_SIGNUPS": { "type": "boolean", "default": true }
}
